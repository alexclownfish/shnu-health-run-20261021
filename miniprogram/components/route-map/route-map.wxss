:host { display: block; }
.map-shell { position: relative; overflow: hidden; width: 100%; aspect-ratio: 992 / 554; min-height: 330rpx; border-radius: 13rpx; background: #e8f7fa; }
.route-map-image { display: block; width: 100%; height: auto; }
.map-badge { position: absolute; z-index: 3; left: 18rpx; bottom: 18rpx; padding: 7rpx 12rpx; border: 1rpx solid rgba(0,88,165,.16); border-radius: 8rpx; color: #0058a5; background: rgba(255,255,255,.92); font-size: 17rpx; }
