<view class="page certificate-page">
  <view wx:if="{{certificateReady}}" class="certificate card">
    <view class="certificate-top">
      <view class="decor decor-one"></view><view class="decor decor-two"></view>
      <text class="certificate-code mono">步履拾光 / 完赛凭证</text>
      <text class="certificate-title">步履拾光·健康同行</text>
      <text class="certificate-subtitle">完成实景健康路线</text>
      <view class="complete-seal">✓</view>
    </view>
    <view class="certificate-body">
      <text class="certificate-id mono">YOU-PAI-{{certificateId}}</text>
      <text class="certificate-owner">{{ownerName}} 的健康完赛凭证</text>
      <view class="score"><text>3/3</text><text>打卡完成</text></view>
      <view class="certificate-stations">
        <view wx:for="{{stations}}" wx:key="id">
          <text class="station-dot">{{item.id}}</text>
          <text>{{item.title}} · {{item.location}}</text>
          <text>完成</text>
        </view>
      </view>
      <text class="certificate-note">{{distance}} km · 起终点计时完成 · 能量已释放</text>
      <view class="certificate-meta">
        <text>完成时间 <text>{{completedTime}}</text></text>
        <text>总用时 <text>{{completionDuration}}</text></text>
      </view>
      <view class="certificate-footer">
        <text class="certificate-participant mono">参与者编号：{{participantId || '上传后生成'}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-certificate card">
    <view class="empty-icon">⌁</view>
    <text>凭证还在路上</text>
    <text>扫描起点、完成 3 个健康点位并扫描终点后，即可生成专属完赛凭证。</text>
  </view>

  <view class="certificate-actions" wx:if="{{certificateReady}}">
    <button class="secondary-button" loading="{{savingCertificate}}" disabled="{{savingCertificate}}" bindtap="saveCertificate"><text wx:if="{{!savingCertificate}}">⇩</text><text>{{savingCertificate ? '正在生成' : '保存凭证'}}</text></button>
    <button class="secondary-button" open-type="share"><text>⌁</text><text>分享给同事</text></button>
  </view>
  <button class="primary-button back-home" bindtap="backHome"><text>返回活动首页</text><text class="arrow">⌂</text></button>

  <canvas type="2d" id="certificateCanvas" class="certificate-canvas"></canvas>
</view>
