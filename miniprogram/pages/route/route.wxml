<view class="page route-page with-fixed-action">
  <view class="route-heading">
    <view><text class="eyebrow">上海师范大学教职工活动</text><text class="page-title">步履拾光·健康同行</text></view>
    <view class="profile-dot" bindtap="openProfileAuthorization"><image wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill"></image><text wx:else>{{userInitial}}</text></view>
  </view>

  <view class="weather card">
    <view class="weather-symbol">◷</view>
    <view class="weather-copy">
      <text>{{activity.scoreLabel}}</text>
      <text>{{activity.subtitle}}</text>
    </view>
    <view class="weather-score">
      <text>{{completed}} / 3</text>
      <text>已完成</text>
    </view>
  </view>

  <view class="challenge">
    <view class="challenge-ring ring-one"></view>
    <view class="challenge-ring ring-two"></view>
    <view class="challenge-copy">
      <text class="challenge-code mono">TODAY / ROUTE 01</text>
      <text class="challenge-title">{{totalDistance}} 公里实景健康漫步</text>
      <text class="challenge-desc">起点开始计时 · 3 次照片打卡 · 终点结束计时</text>
    </view>
  </view>

  <view class="route-card card">
    <view class="route-card-head">
      <view>
        <text class="section-kicker">今日路线</text>
        <text class="route-card-title">{{progressTitle}}</text>
      </view>
      <text class="section-side">{{completed}} / 3 点位</text>
    </view>

    <view class="map"><route-map completed="{{completed}}" bindstationtap="handleStationTap"></route-map></view>
    <view class="route-timer"><text class="timer-icon">◷</text><view><text>{{timingStatus}}</text><text>{{elapsedLabel}}</text></view></view>
    <view class="route-flow"><view class="flow-node {{started ? 'done' : 'current'}}"><text>起</text><text>起点</text></view><text class="flow-arrow">›</text><view class="flow-node {{completed > 0 ? 'done' : completed === 0 && started ? 'current' : ''}}"><text>A</text><text>起步站</text></view><text class="flow-arrow">›</text><view class="flow-node {{completed > 1 ? 'done' : completed === 1 ? 'current' : ''}}"><text>B</text><text>途中站</text></view><text class="flow-arrow">›</text><view class="flow-node {{completed > 2 ? 'done' : completed === 2 ? 'current' : ''}}"><text>C</text><text>终点站</text></view><text class="flow-arrow">›</text><view class="flow-node {{finished ? 'done' : completed === 3 ? 'current' : ''}}"><text>终</text><text>终点</text></view></view>
    <view class="map-hint"><text class="scan-icon">⌗</text><text>{{mapHint}}</text></view>
  </view>

  <view class="section-head">
    <view><text class="section-kicker">沿途任务</text><text class="section-title">3 个健康点位</text></view>
    <text class="demo-link">按顺序完成</text>
  </view>

  <view class="station-list">
    <view class="station-card card endpoint-card {{started ? 'done' : ''}}" bindtap="handleStartTap">
      <view class="station-number">{{started ? '✓' : '起'}}</view>
      <view class="station-copy"><text>起点</text><text>{{started ? '起点已打卡' : '扫描起点二维码'}}</text></view>
      <view class="station-meta"><text>{{started ? '已完成' : '下一点'}}</text><text>开始计时</text></view>
    </view>
    <view wx:for="{{stations}}" wx:key="id" class="station-card card {{item.done ? 'done' : ''}} {{item.locked ? 'locked' : ''}}" data-index="{{index}}" bindtap="handleStationTap">
      <view class="station-number">{{item.done ? '✓' : item.number}}</view>
      <view class="station-copy"><text>{{item.title}}</text><text>{{item.location}} · {{item.tag}}</text></view>
      <view class="station-meta"><text>{{item.status}}</text></view>
    </view>
    <view class="station-card card endpoint-card {{finished ? 'done' : ''}} {{completed < 3 ? 'locked' : ''}}" bindtap="handleFinishTap">
      <view class="station-number">{{finished ? '✓' : '终'}}</view>
      <view class="station-copy"><text>终点</text><text>{{finished ? '终点已打卡' : '三个任务点完成后扫码'}}</text></view>
      <view class="station-meta"><text>{{finished ? '已完成' : completed === 3 ? '下一点' : '待解锁'}}</text><text>结束计时</text></view>
    </view>
  </view>

  <view class="fixed-action">
    <button class="primary-button" bindtap="handleStart"><text>{{ctaLabel}}</text><text class="arrow">↗</text></button>
  </view>

  <profile-auth visible="{{profileVisible}}" user="{{user}}" bindsave="saveAuthorizedProfile" bindclose="closeProfileAuthorization"></profile-auth>
</view>
