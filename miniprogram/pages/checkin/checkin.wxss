.checkin-page { display: flex; min-height: 100vh; flex-direction: column; padding-top: 34rpx; }
.status-line { display: flex; align-items: center; gap: 14rpx; color: var(--orange); font-size: 19rpx; }
.status-dot.active { background: var(--primary); box-shadow: 0 0 0 7rpx rgba(86,100,194,.16); animation: pulse 1.2s ease-in-out infinite; }
.status-dot.success { background: var(--deep); }
.status-dot.error { background: var(--coral); box-shadow: 0 0 0 7rpx rgba(241,91,104,.13); }
@keyframes pulse { 50% { opacity: .45; transform: scale(.8); } }
.reader { position: relative; height: 510rpx; display: flex; align-items: center; justify-content: center; margin-top: 34rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 18rpx; background: var(--lavender); }
.reader-ring { position: absolute; border: 38rpx solid rgba(86,100,194,.14); border-radius: 50%; animation: scan 1.8s ease-in-out infinite; }
.ring-a { width: 390rpx; height: 390rpx; }
.ring-b { width: 270rpx; height: 270rpx; border-color: rgba(247,107,43,.2); animation-delay: .35s; }
@keyframes scan { 50% { opacity: .35; transform: scale(.9); } }
.reader-phone { position: relative; z-index: 2; width: 180rpx; height: 300rpx; display: flex; align-items: center; justify-content: center; border: 9rpx solid var(--ink); border-radius: 34rpx; color: #fff; background: var(--primary); font-family: monospace; font-size: 34rpx; font-weight: 700; }
.reader-speaker { position: absolute; top: 17rpx; width: 48rpx; height: 7rpx; border-radius: 6rpx; background: var(--ink); }
.reader-tag { position: absolute; z-index: 3; right: 76rpx; bottom: 84rpx; width: 116rpx; height: 94rpx; display: flex; align-items: center; justify-content: center; border: 6rpx solid var(--deep); border-radius: 14rpx; color: var(--ink); background: var(--yellow); font-family: monospace; font-size: 20rpx; font-weight: 700; transform: rotate(6deg); }
.reader-success { background: var(--lavender); }
.reader-success .reader-phone { color: #fff; background: var(--deep); }
.reader-error { background: #fff0ec; }
.reader-error .reader-phone { background: var(--coral); }
.reader-error .reader-ring { border-color: rgba(241,91,104,.14); animation: none; }
.reader-idle .reader-ring { opacity: .45; animation: none; }
.reader-qr { background: #e5f7fb; }
.reader-qr .reader-phone { background: var(--primary); }
.reader-qr .reader-tag { color: var(--ink); background: var(--yellow); }
.result-copy { padding: 36rpx 4rpx 22rpx; }
.result-title, .result-message { display: block; }
.result-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 800; line-height: 1.3; }
.result-message { margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }
.assurance-note { display: grid; gap: 7rpx; margin-top: auto; padding: 22rpx; border-left: 7rpx solid var(--primary); border-radius: 8rpx; background: var(--lavender); color: #596080; font-size: 19rpx; line-height: 1.55; }
.assurance-note .note-title { color: var(--ink); font-size: 22rpx; font-weight: 700; }
.checkin-actions { display: grid; gap: 14rpx; margin-top: 24rpx; }
